# Copia este archivo como ".env" y completa tu API key para modo LLM.
# Si se deja vacío, el agente arranca en MODO OFFLINE (guion determinístico),
# útil como respaldo de contingencia para la demo en vivo.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

APP_NAME=Agente Cotizador de Equipos Médicos
COMPANY_DISPLAY_NAME=Demo Webinar - Agentes de IA con AWS

CHECKPOINT_DB_PATH=data/checkpoints.sqlite
QUOTES_DIR=data/quotes

# Si se define REDIS_URL, el checkpointer de conversación usa Redis en vez de
# SQLite (necesario para correr más de una réplica del contenedor en AWS).
# Formato: redis://usuario:password@host:puerto
# NUNCA subas la URL real con contraseña a git — solo en tu .env local o en
# AWS Secrets Manager para producción.
REDIS_URL=
